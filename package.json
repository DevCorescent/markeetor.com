{
  "name": "leads-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "SERVICE_NAME=leads-crm-worker tsx --env-file=.env src/worker/index.ts",
    "worker:dev": "tsx watch --env-file=.env src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:test:prepare": "dotenv -e .env -v DATABASE_URL=$TEST_DATABASE_URL -- sh -c \"prisma migrate reset --force --skip-seed\"",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "audit:deps": "npm audit --omit=dev",
    "openapi": "tsx --env-file=.env --tsconfig tsconfig.json scripts/openapi.ts",
    "worker:prod": "SERVICE_NAME=leads-crm-worker tsx src/worker/index.ts",
    "openapi:static": "tsx --tsconfig tsconfig.json scripts/openapi.ts",
    "db:setup": "bash scripts/db-setup.sh",
    "db:bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "db:seed:accounts": "tsx --tsconfig tsconfig.json --env-file=.env scripts/seed-accounts.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/otel": "^2.1.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "papaparse": "^5.7.0",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pino-pretty": "^13.1.3",
    "smtp-server": "^3.19.16",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract": false
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
