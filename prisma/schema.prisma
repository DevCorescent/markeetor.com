  organizationId String?
  provider       String // SMTP | TWILIO_SMS | WHATSAPP_BUSINESS | AI_SCORING
  enabled        Boolean  @default(false)
  config         Json     @default("{}") // non-secret settings only; secrets come from env
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, provider])
  @@map("integration_configs")
}

model SavedView {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  scope          String // ADMIN_LEADS | CLIENT_LEADS | ADMIN_DASHBOARD | AUDIT | REPORT
  name           String
  state          Json
  createdAt      DateTime @default(now())

  @@unique([userId, scope, name])
  @@map("saved_views")
}

model SavedReport {
  id             String    @id @default(cuid())
  ownerId        String
  organizationId String?
