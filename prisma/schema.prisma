// markeetor.com — tenant-aware data model.
//
// Tenancy model (see DEVELOPMENT.md → "Lead ownership model"):
//   * `Lead` is the platform-owned MASTER record. Client users never read it.
//   * `LeadAssignment` records which organization currently holds a lead
//     (at most one ACTIVE assignment per lead, enforced by a partial unique index).
//   * `ClientLead` is the tenant-specific PROJECTION created at assignment time.
//     All client CRM work (status, stage, notes, tasks, communication) hangs off it.
//     When a lead is revoked/reassigned, the old projection is hidden from the old
//     tenant and never shown to the new one.
//
// Tables carrying `organizationId` that are tenant-private are protected by
// PostgreSQL row-level security (see prisma/migrations/*_rls). Column names are
// left in Prisma's camelCase, so raw SQL must quote them ("organizationId").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
}

enum OrgStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum OverrideEffect {
  GRANT
  DENY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum LeadQuality {
  VALID
  INVALID
}

enum AllocationStatus {
  UNALLOCATED
  PENDING
  ALLOCATED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  PREVIEW_READY
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum ImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  INSERTED
  UPDATED
  SKIPPED
  FAILED
}

enum BatchStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum BatchItemStatus {
  PENDING
  ASSIGNED
  SKIPPED
  FAILED
  ROLLED_BACK
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
  REASSIGNED
  ROLLED_BACK
}

enum DistributionStrategy {
  EQUAL
  CUSTOM
  ROUND_ROBIN
  WEIGHTED
  QUOTA
  CAPACITY
  GEOGRAPHY
  INDUSTRY
  CAMPAIGN
  SCORE
}

enum ClientLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum StageCategory {
  OPEN
  WON
  LOST
}

enum ActivityVerification {
  SYSTEM_VERIFIED
  SELF_REPORTED
  PROVIDER_VERIFIED
}

enum TaskType {
  TODO
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum CommChannel {
  CALL
  EMAIL
  SMS
  WHATSAPP
  MEETING
}

enum CommDirection {
  OUTBOUND
  INBOUND
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  DEAD
}

enum EmailStatus {
  QUEUED
  SENT
  LOGGED_ONLY
  FAILED
}

// ─────────────────────── Identity & access ───────────────────────

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique // stored lower-cased
  name                  String
  passwordHash          String?
  status                UserStatus @default(INVITED)
  isPlatformUser        Boolean    @default(false)
  mfaEnabled            Boolean    @default(false)
  mfaSecretEnc          String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryHashes     String[]   @default([])
  failedLoginCount      Int        @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  passwordChangedAt     DateTime?
  /// Set for accounts created with an emailed temporary password; cleared once the user picks their own.
  mustChangePassword    Boolean    @default(false)
  tempPasswordExpiresAt DateTime?
  title                 String?
  phone                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  membership       Membership?
  sessions         Session[]
  loginEvents      LoginEvent[]
  notifications    Notification[]
  resetTokens      PasswordResetToken[]
  ownedClientLeads ClientLead[]         @relation("ClientLeadOwner")
  tasksAssigned    Task[]               @relation("TaskAssignee")
  teamMemberships  TeamMember[]
  savedViews       SavedView[]

  @@map("users")
}

model Organization {
  id           String    @id @default(cuid())
  code         String    @unique // human-facing identifier, e.g. ORG-7XK2Q9
  slug         String    @unique
  name         String
  legalName    String?
  industry     String?
  website      String?
  contactEmail String?
  contactPhone String?
  address      String?
  timezone     String    @default("UTC")
  logoKey      String?
  status       OrgStatus @default(ACTIVE)
  // { features: {...}, security: { mfaRequired, sessionIdleMinutes, ipAllowlist[] }, notifications: {...} }
  settings     Json      @default("{}")
  statusReason String?
  /// Tax registration for invoices (India: 15-character GSTIN) and the state it is registered in.
  gstin        String?
  billingState String?
  archivedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  quota       ClientQuota?
  roles       Role[]
  assignments LeadAssignment[]
  clientLeads ClientLead[]

  @@index([status])
  @@map("organizations")
}

model ClientQuota {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maxUsers                Int          @default(25)
  maxActiveLeads          Int          @default(5000)
  dailyAllocationLimit    Int          @default(1000)
  monthlyAllocationLimit  Int          @default(20000)
  weight                  Int          @default(1)
  acceptsAutoDistribution Boolean      @default(true)
  autoPauseAtCapacity     Boolean      @default(true)
  capacityPaused          Boolean      @default(false)
  pausedAt                DateTime?
  // Eligibility profile used by rule-based distribution.
  regions                 String[]     @default([])
  industries              String[]     @default([])
  campaigns               String[]     @default([])
  minScore                Int?
  maxScore                Int?
  updatedAt               DateTime     @updatedAt

  @@map("client_quotas")
}

model Role {
  id             String        @id @default(cuid())
  key            String
  name           String
  description    String?
  scope          RoleScope
  organizationId String? // null → system role template available to every org (for ORGANIZATION scope)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isSystem       Boolean       @default(false)
  isPrivileged   Boolean       @default(false) // granting requires approval
  rank           Int           @default(0) // higher = more privileged; prevents escalation
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  permissions RolePermission[]
  memberships Membership[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  key         String    @id
  description String
  scope       RoleScope
  sensitive   Boolean   @default(false)
  group       String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String
  permissionKey String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

// v1: one membership per user (a user belongs to the platform OR exactly one org).
model Membership {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  overrides PermissionOverride[]

  @@index([organizationId])
  @@map("memberships")
}

model PermissionOverride {
  id            String         @id @default(cuid())
  membershipId  String
  membership    Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionKey String
  effect        OverrideEffect
  reason        String
  grantedById   String
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())

  @@unique([membershipId, permissionKey])
  @@map("permission_overrides")
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaPending    Boolean   @default(false)
  mfaVerifiedAt DateTime?
  stepUpAt      DateTime?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId, revokedAt])
  @@map("sessions")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  name           String
  organizationId String?
  roleId         String
  tokenHash      String    @unique
  invitedById    String
  userId         String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([organizationId])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  type          String // ROLE_GRANT_PRIVILEGED | DISTRIBUTION_ROLLBACK_FORCED | ...
  summary       String
  payload       Json
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  expiresAt     DateTime
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@map("approval_requests")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  prefix         String    @unique
  keyHash        String
  scopes         String[]
  createdById    String
  lastUsedAt     DateTime?
  lastUsedIp     String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@map("api_keys")
}

// ───────────────────────── Master leads ─────────────────────────

model Lead {
  id                     String            @id @default(cuid())
  fullName               String
  email                  String?
  emailNormalized        String?
  phone                  String?
  phoneNormalized        String? // E.164
  secondaryPhone         String?
  company                String?
  jobTitle               String?
  country                String?
  state                  String?
  city                   String?
  industry               String?
  source                 String?
  campaign               String?
  score                  Int               @default(0)
  priority               Priority          @default(MEDIUM)
  quality                LeadQuality       @default(VALID)
  qualityIssues          String[]          @default([])
  allocationStatus       AllocationStatus  @default(UNALLOCATED)
  assignedOrganizationId String?
  duplicateOfId          String?
  mergedIntoId           String?
  customFields           Json              @default("{}")
  importBatchId          String?
  importBatch            ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  lastActivityAt         DateTime?
  nextFollowUpAt         DateTime?
  clientStatus           ClientLeadStatus? // denormalized from active projection, for global analytics
  distributionCount      Int               @default(0) // how many times this lead has been allocated to a client
  lastDistributedAt      DateTime?
  archivedAt             DateTime?
  archivedReason         String?
  createdById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tags        LeadTag[]
  assignments LeadAssignment[]
  batchItems  AssignmentBatchItem[]
  enrichment  LeadEnrichment?

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@index([allocationStatus, archivedAt])
  @@index([assignedOrganizationId])
  @@index([source])
  @@index([campaign])
  @@index([industry])
  @@index([country])
  @@index([createdAt])
  @@index([score])
  @@index([importBatchId])
  @@index([distributionCount])
  @@index([lastDistributedAt])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_fullname_trgm")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_company_trgm")
  @@index([emailNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_email_trgm")
  @@map("leads")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String? // null → platform tag
  name           String
  color          String?
  createdAt      DateTime @default(now())

  leads       LeadTag[]
  clientLeads ClientLeadTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags")
}

model CustomFieldDefinition {
  id             String    @id @default(cuid())
  organizationId String? // null → platform (master lead) field
  key            String
  label          String
  type           FieldType @default(TEXT)
  options        String[]  @default([])
  required       Boolean   @default(false)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@unique([organizationId, key])
  @@map("lead_custom_fields")
}

// ─────────────────────────── Imports ───────────────────────────

model ImportBatch {
  id             String       @id @default(cuid())
  code           String       @unique
  fileName       String
  fileSize       Int
  fileType       String // csv | xlsx
  storageKey     String?
  fileDeletedAt  DateTime?
  status         ImportStatus @default(UPLOADED)
  headers        String[]     @default([])
  mapping        Json         @default("{}") // { columnHeader: fieldKey }
  options        Json         @default("{}") // { dedupeKeys, onDuplicate, requiredFields, defaultCountry }
  source         String?
  campaign       String?
  tags           String[]     @default([])
  totalRows      Int          @default(0)
  processedRows  Int          @default(0)
  validCount     Int          @default(0)
  invalidCount   Int          @default(0)
  duplicateCount Int          @default(0)
  insertedCount  Int          @default(0)
  updatedCount   Int          @default(0)
  skippedCount   Int          @default(0)
  failedCount    Int          @default(0)
  error          String?
  templateId     String?
  // Draft / smart-parsing state (wizard can be resumed and stepped back through until confirmed).
  draftStep      String       @default("mapping")
  sheetName      String?
  sheets         Json         @default("[]")
  headerRow      Int          @default(1)
  delimiter      String?
  encoding       String?
  detection      Json         @default("{}") // per-column suggested field, confidence and reasons
  createdById    String
  confirmedAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  rolledBackAt   DateTime?
  rolledBackById String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rows  ImportRow[]
  leads Lead[]

  @@index([status, createdAt])
  @@map("imports")
}

model ImportRow {
  id          String          @id @default(cuid())
  importId    String
  import      ImportBatch     @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber   Int
  raw         Json
  normalized  Json?
  status      ImportRowStatus
  errors      String[]        @default([])
  matchLeadId String?
  leadId      String?
  before      Json? // snapshot for UPDATED rows, enables rollback

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("import_rows")
}

model ImportTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  mapping     Json
  options     Json     @default("{}")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("import_templates")
}

// ───────────────────────── Distribution ─────────────────────────

model AssignmentBatch {
  id             String               @id @default(cuid())
  code           String               @unique
  mode           String // MANUAL | RULE | REASSIGN
  strategy       DistributionStrategy
  selection      Json // criteria used to select leads (filter or explicit ids)
  targets        Json // [{ organizationId, quantity?, weight? }]
  rules          Json                 @default("{}")
  ruleId         String?
  idempotencyKey String               @unique
  status         BatchStatus          @default(QUEUED)
  scheduledFor   DateTime?
  selectedCount  Int                  @default(0)
  allocatedCount Int                  @default(0)
  failedCount    Int                  @default(0)
  skippedCount   Int                  @default(0)
  pendingCount   Int                  @default(0)
  initiatedById  String
  note           String?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  rolledBackAt   DateTime?
  rolledBackById String?
  rollbackReason String?
  rollbackCount  Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  items       AssignmentBatchItem[]
  assignments LeadAssignment[]

  @@index([status, createdAt])
  @@index([scheduledFor])
  @@map("assignment_batches")
}

model AssignmentBatchItem {
  id             String          @id @default(cuid())
  batchId        String
  batch          AssignmentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?
  status         BatchItemStatus @default(PENDING)
  reason         String?
  assignmentId   String?
  processedAt    DateTime?

  @@unique([batchId, leadId])
  @@index([batchId, status])
  @@index([organizationId])
  @@map("assignment_batch_items")
}

model LeadAssignment {
  id             String           @id @default(cuid())
  leadId         String
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          AssignmentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status         AssignmentStatus @default(ACTIVE)
  assignedById   String
  assignedAt     DateTime         @default(now())
  endedAt        DateTime?
  endedById      String?
  endedReason    String?

  clientLead ClientLead?

  // Partial unique index "lead_assignments_one_active" (lead) WHERE status='ACTIVE' lives in SQL migration.
  @@index([leadId, status])
  @@index([organizationId, status, assignedAt])
  @@index([batchId])
  @@index([assignedAt])
  @@index([leadId, organizationId], map: "lead_assignments_lead_org_idx")
  @@map("lead_assignments")
}

model DistributionRule {
  id              String               @id @default(cuid())
  name            String
  description     String?
  strategy        DistributionStrategy
  enabled         Boolean              @default(false)
  trigger         String               @default("MANUAL") // MANUAL | SCHEDULED | ON_IMPORT
  intervalMinutes Int?
  // { filter: LeadFilter, targets: [{organizationId, weight}], maxPerRun, onlyUnallocated }
  config          Json
  version         Int                  @default(1)
  lastRunAt       DateTime?
  lastBatchId     String?
  createdById     String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("distribution_rules")
}

// ─────────────────────── Client CRM (tenant) ───────────────────────

model ClientLead {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String
  assignmentId      String           @unique
  assignment        LeadAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  // Working copy of contact details (client-editable, never written back to master).
  fullName          String
  email             String?
  phone             String?
  secondaryPhone    String?
  company           String?
  jobTitle          String?
  country           String?
  state             String?
  city              String?
  industry          String?
  // Attribution snapshot — read-only for clients.
  source            String?
  campaign          String?
  score             Int              @default(0)
  priority          Priority         @default(MEDIUM)
  status            ClientLeadStatus @default(NEW)
  ownerId           String?
  owner             User?            @relation("ClientLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId            String?
  pipelineId        String?
  stageId           String?
  stage             PipelineStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  stageEnteredAt    DateTime?
  dealValue         Decimal?         @db.Decimal(14, 2)
  currency          String           @default("USD")
  expectedCloseDate DateTime?
  probability       Int?
  lostReason        String?
  customFields      Json             @default("{}")
  firstContactAt    DateTime?
  lastActivityAt    DateTime?
  nextFollowUpAt    DateTime?
  convertedAt       DateTime?
  lostAt            DateTime?
  archivedAt        DateTime?
  revokedAt         DateTime? // assignment ended → hidden from tenant
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  notes       Note[]
  tasks       Task[]
  comms       CommunicationLog[]
  attachments Attachment[]
  tags        ClientLeadTag[]

  @@index([organizationId, revokedAt, archivedAt, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, stageId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_leads_fullname_trgm")
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_leads_company_trgm")
  @@map("client_leads")
}

model ClientLeadTag {
  clientLeadId   String
  tagId          String
  organizationId String
  clientLead     ClientLead @relation(fields: [clientLeadId], references: [id], onDelete: Cascade)
  tag            Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientLeadId, tagId])
  @@map("client_lead_tags")
}

model Pipeline {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  stages         PipelineStage[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id                String        @id @default(cuid())
  organizationId    String
  pipelineId        String
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name              String
  position          Int
  category          StageCategory @default(OPEN)
  probability       Int           @default(0)
  stagnantAfterDays Int?
  requiresApproval  Boolean       @default(false)
  createdAt         DateTime      @default(now())

  clientLeads ClientLead[]

  @@index([pipelineId, position])
  @@map("pipeline_stages")
}

model StageHistory {
  id             String   @id @default(cuid())
  organizationId String
  clientLeadId   String
  fromStageId    String?
  toStageId      String
  changedById    String?
  durationMs     BigInt?
  createdAt      DateTime @default(now())

  @@index([organizationId, clientLeadId, createdAt])
  @@map("stage_history")
}

// Lead lifecycle & tracking events. organizationId null → platform-side event.
model Activity {
  id             String               @id @default(cuid())
  organizationId String?
  leadId         String?
  clientLeadId   String?
