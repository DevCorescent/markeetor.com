  definition     Json // { metric, groupBy, filters, range }
  schedule       String? // DAILY | WEEKLY | MONTHLY
  recipients     String[]  @default([])
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("saved_reports")
}

// Single-row chain head for the audit hash chain. Managed exclusively by the
// audit_events_chain() trigger — application code must not write to it.
model AuditChainHead {
  id       Int     @id
  lastHash String? @map("last_hash")
  lastSeq  BigInt  @default(0) @map("last_seq")

  @@map("audit_chain_head")
}

// ─────────────────────────────── Email ───────────────────────────────

enum EmailStatus2 {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

/// SMTP sender accounts. organizationId null → platform account. Passwords are AES-256-GCM encrypted and never returned by the API.
model SmtpAccount {
  id                String    @id @default(cuid())
  organizationId    String?
  label             String
  host              String
  port              Int
  secure            Boolean   @default(true)
  username          String
  passwordEnc       String
  fromName          String
  fromEmail         String
  replyTo           String?
  dailyLimit        Int       @default(500)
  perMinuteLimit    Int       @default(30)
  isDefault         Boolean   @default(false)
  status            String    @default("UNVERIFIED") // UNVERIFIED | VERIFIED | FAILED
  lastVerifiedAt    DateTime?
  lastError         String?
  /// DKIM signing with the From domain (key generated here; public key published in DNS).
  dkimSelector      String?
  dkimPrivateKeyEnc String?
  dkimPublicKey     String?
  dkimEnabled       Boolean   @default(false)
  /// Last deliverability (SPF/DKIM/DMARC/MX…) check result.
  deliverability    Json?
  deliverabilityAt  DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([organizationId])
  @@map("smtp_accounts")
}

model EmailTemplate {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  category       String?
  subject        String
  preheader      String?
  design         Json // block document rendered by src/lib/email/render.ts
  html           String
  text           String
  createdById    String
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  @@index([organizationId, archivedAt])
  @@map("email_templates")
}

model EmailCampaign {
  id              String         @id @default(cuid())
  organizationId  String?
  name            String
  smtpAccountId   String
  templateId      String?
  subject         String
  preheader       String?
  design          Json
  status          CampaignStatus @default(QUEUED)
  audience        Json // selection snapshot
  trackOpens      Boolean        @default(true)
  scheduledFor    DateTime?
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  skippedCount    Int            @default(0)
  openedCount     Int            @default(0)
  error           String?
  createdById     String
  createdAt       DateTime       @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  messages EmailMessage[]

  @@index([organizationId, createdAt])
  @@map("email_campaigns")
}

model EmailMessage {
  id                String         @id @default(cuid())
  organizationId    String?
  campaignId        String?
  campaign          EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  smtpAccountId     String
  leadId            String?
  clientLeadId      String?
  toEmail           String
  toName            String?
  subject           String
  status            EmailStatus2   @default(QUEUED)
  error             String?
  attempts          Int            @default(0)
  providerMessageId String?
  trackingToken     String         @unique
  queuedAt          DateTime       @default(now())
  sentAt            DateTime?
  openedAt          DateTime?
  openCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  // Email endpoints (triggered sends): which endpoint/trigger/step produced this message.
  endpointId        String?
  endpointEventId   String?
  stepIndex         Int?
  scheduledFor      DateTime?
  /// Template variables for endpoint messages (purged after the endpoint's retention period).
  vars              Json?
  cc                String[]       @default([])
  bcc               String[]       @default([])
  clickCount        Int            @default(0)
  clickedAt         DateTime?

  events EmailMessageEvent[]

  @@index([campaignId, status])
  @@index([organizationId, createdAt])
  @@index([clientLeadId])
  @@index([smtpAccountId, sentAt])
  @@index([endpointId, createdAt])
  @@index([toEmail])
  @@map("email_messages")
}

/// Per-message delivery timeline: queued, deferred, sent, failed, opened, clicked, unsubscribed…
model EmailMessageEvent {
  id        String       @id @default(cuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  url       String?
  ip        String?
  userAgent String?
  createdAt DateTime     @default(now())

  @@index([messageId, createdAt])
  @@index([type, createdAt])
  @@map("email_message_events")
}

/// A named email trigger: a platform event or an inbound webhook, with the emails attached to it.
model EmailEndpoint {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?
  status           String    @default("ACTIVE") // ACTIVE | PAUSED
  triggerType      String // EVENT | WEBHOOK
  event            String?
  tokenHash        String?   @unique
  tokenPreview     String?
  signingSecretEnc String?
  category         String    @default("TRANSACTIONAL") // TRANSACTIONAL | MARKETING
  smtpAccountId    String?
  /// Recipients, conditions, attached emails and delivery options (validated by the endpoint schema).
  config           Json
  lastTriggeredAt  DateTime?
  createdById      String
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  events EmailEndpointEvent[]

  @@index([triggerType, event, status])
  @@map("email_endpoints")
}

/// One trigger of an endpoint (an event fired or a webhook call) and what came of it.
model EmailEndpointEvent {
  id             String        @id @default(cuid())
  endpointId     String
  endpoint       EmailEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  source         String // EVENT | WEBHOOK | TEST | REPLAY
  status         String // ACCEPTED | FILTERED | DUPLICATE | THROTTLED | PAUSED | NO_RECIPIENTS
  reason         String?
  idempotencyKey String?
  payload        Json?
  recipients     Int           @default(0)
  messages       Int           @default(0)
  ip             String?
  replayOfId     String?
  createdAt      DateTime      @default(now())

  @@unique([endpointId, idempotencyKey])
  @@index([endpointId, createdAt])
  @@map("email_endpoint_events")
}

/// Addresses that must not be emailed (unsubscribed, bounced, manual). Stored as SHA-256 of the normalized address.
model EmailSuppression {
  id             String   @id @default(cuid())
  organizationId String?
  emailHash      String
  reason         String // UNSUBSCRIBED | BOUNCED | MANUAL
  createdAt      DateTime @default(now())

  @@unique([organizationId, emailHash])
  @@map("email_suppressions")
}

// ── Lead marketplace & announcements ─────────────────────────────────

enum LeadRequestStatus {
  PENDING
  FULFILLED
  PARTIAL
  REJECTED
  CANCELLED
}

enum BillingStatus {
  NONE // nothing to pay (free demo leads only)
  DUE
  PAID
  WAIVED
  VOID
}

/// A client's request to receive specific marketplace leads, with its price quote and billing state.
model LeadRequest {
  id             String            @id @default(cuid())
  code           String            @unique
  organizationId String
  requestedById  String
  status         LeadRequestStatus @default(PENDING)
  note           String?
  adminNote      String?
  leadCount      Int
  deliveredCount Int               @default(0)
  freeApplied    Int               @default(0)
  currency       String            @default("USD")
  subtotal       Decimal           @default(0) @db.Decimal(12, 2)
  discount       Decimal           @default(0) @db.Decimal(12, 2)
  tax            Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @default(0) @db.Decimal(12, 2)
  quote          Json // price lines, rules applied, volume tier
  billingStatus  BillingStatus     @default(NONE)
  /// INVOICE (billed after delivery) or CREDITS (prepaid credits held at request, settled on delivery).
  paymentMethod  String            @default("INVOICE")
  creditsCharged Int               @default(0)
  couponId       String?
  couponCode     String?
  couponDiscount Decimal           @default(0) @db.Decimal(12, 2)
  invoiceNumber  String?           @unique
  paidAt         DateTime?
  batchId        String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items LeadRequestItem[]

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("lead_requests")
}

model LeadRequestItem {
  id             String      @id @default(cuid())
  requestId      String
  request        LeadRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  organizationId String
  leadId         String
  price          Decimal     @db.Decimal(12, 2)
  free           Boolean     @default(false)
  status         String      @default("REQUESTED") // REQUESTED | DELIVERED | UNAVAILABLE | RELEASED

  @@unique([requestId, leadId])
  @@index([leadId])
  @@index([organizationId])
  @@map("lead_request_items")
}

/// Broadcast notifications sent by the platform to client dashboards (manual or automatic).
model Announcement {
  id             String   @id @default(cuid())
  kind           String // MANUAL | NEW_LEADS
  title          String
  body           String?
  link           String?
  audience       Json // { scope: 'ALL' | 'ORGS', organizationIds?: string[], includePlatform?: boolean }
  recipientCount Int      @default(0)
  orgCount       Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("announcements")
}

enum CouponType {
  PERCENT // % off the paid subtotal
  FIXED // fixed amount off
  FREE_LEADS // extra free leads in the request
}

/// Discount codes created by the platform. Visible coupons are offered on client dashboards.
model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  name             String
  description      String?
  type             CouponType
  value            Decimal    @db.Decimal(12, 2)
  maxDiscount      Decimal?   @db.Decimal(12, 2)
  minLeads         Int        @default(0)
  minSubtotal      Decimal    @default(0) @db.Decimal(12, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  maxRedemptions   Int? // across all clients
  perClientLimit   Int        @default(1)
  organizationIds  String[]   @default([]) // empty = every client
  visibleToClients Boolean    @default(true)
  firstRequestOnly Boolean    @default(false)
  active           Boolean    @default(true)
  createdById      String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  organizationId String
  requestId      String   @unique
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  extraFreeLeads Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([organizationId, couponId])
  @@map("coupon_redemptions")
}

// ── Funnels (client workspaces) ──────────────────────────────────────

/// A client-defined funnel: an ordered set of stages, each defined by lead filter conditions.
model Funnel {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  baseFilter     Json     @default("{\"conditions\":[]}")
  stages         Json // [{ id, name, description?, conditions[], automation? }]
  goal           String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns   FunnelCampaign[]
  enrollments FunnelEnrollment[]

  @@index([organizationId, status])
  @@map("funnels")
}

/// A campaign launched against a funnel stage (one-off or by a stage automation).
model FunnelCampaign {
  id              String   @id @default(cuid())
  organizationId  String
  funnelId        String
  funnel          Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stageId         String
  stageName       String
  scope           String // CURRENT | REACHED
  channel         String // EMAIL | TASK | NOTIFY
  name            String
  automated       Boolean  @default(false)
  emailCampaignId String?
  recipients      Int      @default(0)
  skipped         Int      @default(0)
  details         Json?
  createdById     String
  createdAt       DateTime @default(now())

  @@index([organizationId, funnelId, createdAt])
  @@map("funnel_campaigns")
}

/// Tracks which leads a stage automation has already acted on (each lead once per stage).
model FunnelEnrollment {
  id             String   @id @default(cuid())
  organizationId String
  funnelId       String
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  stageId        String
  clientLeadId   String
  enteredAt      DateTime @default(now())
  result         String?

  @@unique([funnelId, stageId, clientLeadId])
  @@index([organizationId])
  @@map("funnel_enrollments")
}

// ── Business onboarding forms (platform) ─────────────────────────────

model OnboardingForm {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | CLOSED
  config      Json // fields, steps, design, content, settings
  assets      Json     @default("{}") // { logo?, cover? } uploaded images
  views       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications OnboardingApplication[]

  @@map("onboarding_forms")
}

model OnboardingApplication {
  id             String         @id @default(cuid())
  formId         String
  form           OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  status         String         @default("PENDING") // PENDING | APPROVED | REJECTED | SPAM
  businessName   String
  contactName    String
  email          String
  phone          String?
  website        String?
  industry       String?
  country        String?
  answers        Json
  leadInterests  Json?
  flags          String[]       @default([])
  quality        Int            @default(0)
  ip             String?
  userAgent      String?
  organizationId String?
  decidedById    String?
  decidedAt      DateTime?
  reason         String?
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([formId, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@map("onboarding_applications")
}

enum EnrichmentStatus {
  QUEUED
  RUNNING
  DONE
  PARTIAL
  FAILED
  SKIPPED
}

/// AI enrichment of a master lead: verified public company facts with sources and confidence.
model LeadEnrichment {
  id            String           @id @default(cuid())
  leadId        String           @unique
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status        EnrichmentStatus @default(QUEUED)
  engine        String?
  domain        String?
  confidence    Int              @default(0)
  /// { field: { value, confidence, source } }
  data          Json             @default("{}")
  summary       String?
  sources       Json             @default("[]")
  /// Deterministic checks: email syntax / MX / free / disposable, phone validity and type.
  checks        Json             @default("{}")
  applied       String[]         @default([])
  /// Lower-cased industry, keywords and description — what the Lead Finder searches.
  searchText    String?
  error         String?
  attempts      Int              @default(0)
  applyMode     String           @default("empty")
  batchId       String?
  requestedById String?
  queuedAt      DateTime         @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([batchId])
  @@index([domain])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "lead_enrichments_search_trgm")
  @@map("lead_enrichments")
}

/// Per-domain crawl cache so leads from the same company are researched once.
model DomainSnapshot {
  domain    String   @id
  status    String
  data      Json     @default("{}")
  text      String?
  pages     Json     @default("[]")
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
  @@map("domain_snapshots")
}

/// Company registry facts (MCA via Falcon eBiz / OpenCorporates / CIN on the company site), fetched once per company.
/// Director names and contact details from providers are never stored.
model CompanyRegistryRecord {
  id        String   @id @default(cuid())
  /// CIN / LLPIN / registry number when known.
  regId     String?  @unique
  /// Normalised company name, for name lookups.
  nameKey   String
  source    String
  data      Json     @default("{}")
  fetchedAt DateTime @default(now())

  @@index([nameKey])
  @@map("company_registry_records")
}

// ── Lead credits ────────────────────────────────────────────────────

enum CreditEntryType {
  PURCHASE // credits bought through a completed credit request
  BONUS // bonus credits on a purchase
  WELCOME // credits granted when a workspace's wallet opens
  GRANT // credits added by the platform team
  SPEND // credits used to buy leads
  REFUND // credits returned (undelivered leads, rejected or cancelled requests)
  ADJUSTMENT // credits removed by the platform team
  EXPIRY // credits that passed their expiry date
}

enum CreditRequestStatus {
  PENDING // submitted by the client
  AWAITING_PAYMENT // payment details sent, waiting for the money
  COMPLETED // payment received, credits added
  REJECTED
  CANCELLED
}

/// A workspace's credit balance (the ledger in credit_entries is the source of truth; this row is its running total).
model CreditWallet {
  organizationId       String    @id
  balance              Int       @default(0)
  lifetimeIn           Int       @default(0)
  lifetimeSpent        Int       @default(0)
  lowBalanceNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("credit_wallets")
}

/// Append-only credit ledger. Positive entries are "lots" that are consumed oldest-expiry first (`remaining`).
model CreditEntry {
  id              String          @id @default(cuid())
  organizationId  String
  type            CreditEntryType
  credits         Int // signed
  balanceAfter    Int
  remaining       Int? // lots only: credits of this entry not yet used or expired
  expiresAt       DateTime?
  leadRequestId   String?
  creditRequestId String?
  note            String?
  /// SPEND / ADJUSTMENT / EXPIRY: which lots were consumed [{ id, credits }].
  allocations     Json?
  actorId         String?
  createdAt       DateTime        @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, remaining, expiresAt])
  @@index([leadRequestId])
  @@index([creditRequestId])
  @@index([type, createdAt])
  @@map("credit_entries")
}

/// A client's request to buy credits; the platform team confirms payment and the credits are added.
model CreditRequest {
  id               String              @id @default(cuid())
  code             String              @unique
  organizationId   String
  requestedById    String
  packageId        String?
  packageName      String?
  credits          Int
  bonusCredits     Int                 @default(0)
  currency         String
  amount           Decimal             @db.Decimal(12, 2)
  tax              Decimal             @default(0) @db.Decimal(12, 2)
  total            Decimal             @db.Decimal(12, 2)
  status           CreditRequestStatus @default(PENDING)
  clientNote       String?
  adminNote        String?
  /// Sent to the client when awaiting payment (bank / UPI details, payment link…).
  paymentDetails   String?
  /// The client's payment reference (UTR, transaction id…).
  clientReference  String?
  paymentMethod    String?
  paymentReference String?
  invoiceNumber    String?             @unique
  paidAt           DateTime?
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("credit_requests")
}

