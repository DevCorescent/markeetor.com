// Append-only + hash-chained via DB trigger (see migration *_audit). Never UPDATE/DELETE from app code.
model AuditEvent {
  id             String      @id @default(cuid())
  seq            BigInt      @unique @default(autoincrement())
  actorId        String?
  actorEmail     String?
  actorRole      String?
  organizationId String?
  action         String
  targetType     String?
  targetId       String?
  result         AuditResult @default(SUCCESS)
  reason         String?
  before         Json?
  after          Json?
  metadata       Json?
  requestId      String?
  sessionId      String?
  ip             String?
  userAgent      String?
  prevHash       String?
  hash           String?
  createdAt      DateTime    @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

model SecurityAlert {
