}

model WorkflowDefinition {
  id             String   @id @default(cuid())
  organizationId String? // null → platform workflow (applies to all tenants)
  name           String
  description    String?
  trigger        String // LEAD_ASSIGNED_NO_CONTACT | TASK_OVERDUE | STAGE_STAGNANT | LEAD_UNTOUCHED
  conditions     Json     @default("{}")
  actions        Json     @default("[]")
  graph          Json? // canvas graph {nodes, edges}; when present it is the source of truth for execution
