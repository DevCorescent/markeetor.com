# ─── markeetor.com configuration ───────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
# Public https address of the app. Every email links here (sign-in, unsubscribe, tracking): in production it MUST be
# your real https domain, or mail lands in spam. Open/click tracking is switched off while it is localhost or http.
APP_URL=http://localhost:3000

# PostgreSQL. The application role MUST NOT be a superuser and MUST NOT have
# BYPASSRLS, otherwise row-level security is silently ignored. See scripts/db-setup.sh.
DATABASE_URL=postgresql://leads_app:CHANGE_ME@localhost:5432/leads_crm?schema=public
TEST_DATABASE_URL=postgresql://leads_app:CHANGE_ME@localhost:5432/leads_crm_test?schema=public

# Backups: read-only role with BYPASSRLS (tables FORCE row-level security, so the app role cannot dump them).
BACKUP_DATABASE_URL=postgresql://leads_backup:CHANGE_ME@localhost:5432/leads_crm

# Background jobs and rate limits live in Postgres (tables: jobs, job_schedules,
# rate_limit_counters, kv_store) — there is no Redis or other broker to configure.
# Optional: how often the worker polls for due jobs, in ms (default 2000).
# JOB_POLL_MS=2000

# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# >= 32 chars:              openssl rand -base64 32
SESSION_SECRET=

# Private file storage (imports, attachments, logos). Must not be web-served.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

LOG_LEVEL=info
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Email. Without SMTP_URL, messages are stored in the outbox (Settings → Outbox) and not delivered.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="markeetor.com <no-reply@example.com>"

# OpenTelemetry (optional). When set, traces are exported via OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=leads-crm

# Development seed only: password assigned to every seeded *.test demo account.
SEED_PASSWORD=Demo-Passw0rd!2026
# Development only: allow workspace SMTP senders on private/loopback hosts.
# SMTP_ALLOW_PRIVATE_HOSTS=true

# Lead Finder: enable AI in Settings → AI features and set AI_PROVIDER_API_KEY (Anthropic) to let Claude drive the
# conversation. Optional model override (default claude-sonnet-5). Only aggregate catalog stats are sent.
# AI_MODEL=claude-sonnet-5
# Model for deep company web research (Claude web search tool). Needs AI enabled in Settings → AI.
# AI_RESEARCH_MODEL=claude-opus-5-5
# Optional: lets lead research find a company's website from its name (Brave Search API).
# BRAVE_SEARCH_API_KEY=
# Optional: official company registry data (MCA) for lead research. Falcon eBiz: Company Search + CIN Master Data APIs.
# FALCONEBIZ_API_KEY=
# FALCONEBIZ_DOMAIN=your-registered-domain.com
# OPENCORPORATES_API_TOKEN=

# Online payments for credit purchases (Razorpay Orders + Checkout). Use test keys first.
# Webhook URL: https://<your-domain>/api/v1/public/razorpay/webhook  (events: payment.captured, order.paid, payment.failed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Marketing: WhatsApp & SMS delivery (Admin → Marketing → Controls → Delivery providers).
# Until these are set, keep providers on "Test mode" — messages are recorded on the lead but not delivered.
# WhatsApp Cloud API (Meta). Webhook URL: https://<your-domain>/api/v1/public/whatsapp/webhook (field: messages)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
